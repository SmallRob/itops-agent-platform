# ITOps Agent Platform - Backend Development
# 用于本地开发环境，支持热重载
FROM node:20-slim

ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
WORKDIR /app

# 使用阿里云 Debian 镜像源加速 apt（国内网络环境）
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; s|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources

# Install build dependencies for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package files first for better layer caching
COPY backend/package.json backend/package-lock.json ./

# Install all dependencies and build native modules
RUN npm ci

# Create data directory
RUN mkdir -p /app/data

# Expose API port and debugger port
EXPOSE 3001
EXPOSE 9229

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use tsx watch for hot-reload
CMD ["npm", "run", "dev"]
